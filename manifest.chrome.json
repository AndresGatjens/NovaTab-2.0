{
  "manifest_version": 3,
  "name": "Novantab",
  "short_name": "Novantab",
  "version": "2.0.0",
  "description": "Nueva pestaña elegante y privada: búsqueda, favoritos, carpetas, widgets y personalización. Todos los datos se guardan localmente.",
  "chrome_url_overrides": {
    "newtab": "src/pages/newtab/newtab.html"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*",
    "http://127.0.0.1:8734/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Novantab — añadir página a la cuadrícula",
    "default_popup": "src/pages/popup/popup.html"
  }
}